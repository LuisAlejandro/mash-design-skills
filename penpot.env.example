# Penpot instance (docker compose --env-file penpot.env)
# Copy to penpot.env and run mmd setup (fills PENPOT_SECRET_KEY
# and OD_API_TOKEN). Do not commit penpot.env.

PENPOT_VERSION=2.16
PENPOT_PUBLIC_URI=http://localhost:9001

# Generated by mmd setup.
PENPOT_SECRET_KEY=

# OpenDesign (Compose service open-design, http://127.0.0.1:7457)
OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:latest
OPEN_DESIGN_MEM_LIMIT=4g
OPEN_DESIGN_PORT=7457
OD_CODEX_SANDBOX=danger-full-access

# Generated by mmd setup. Browser basic auth password on Docker Desktop
# (username: open-design). API clients send Authorization: Bearer <token>.
OD_API_TOKEN=

# Agent CLI credentials (optional until you run a design job)
CURSOR_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

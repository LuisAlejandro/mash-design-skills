{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "od-design-candidates/variation-plan.schema.json",
  "title": "DesignCandidatesVariationPlan",
  "type": "object",
  "required": ["variations"],
  "additionalProperties": true,
  "properties": {
    "source": {
      "type": "string",
      "description": "How the plan was produced: agent, user, or fallback"
    },
    "surface": {
      "type": "string",
      "description": "Short label for the UI type"
    },
    "plannerAgent": {
      "type": ["string", "null"]
    },
    "plannerModel": {
      "type": ["string", "null"]
    },
    "variations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["title", "directive"],
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "directive": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}

# Penpot instance (docker compose --env-file penpot.env)
# Copy to penpot.env and run mds setup (fills PENPOT_SECRET_KEY
# and OD_API_TOKEN). Do not commit penpot.env.

PENPOT_VERSION=2.16.2
PENPOT_PUBLIC_URI=http://localhost:9001

# Generated by mds setup.
PENPOT_SECRET_KEY=

# OpenDesign (Compose service open-design, http://127.0.0.1:7457)
OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:0.17.0
OPEN_DESIGN_MEM_LIMIT=4g
OPEN_DESIGN_PORT=7457
OD_CODEX_SANDBOX=danger-full-access

# Loopback UI at :7457 has no login prompt. Skills may still send Bearer.
OPEN_DESIGN_DISABLE_API_AUTH=1
OD_API_TOKEN=

# Generated by mds setup. Login email for local Penpot (password is not stored).
PENPOT_LOCAL_EMAIL=

# Agent CLI credentials. `mds setup` / `mds auth` write these; `mds start` applies them.
CURSOR_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

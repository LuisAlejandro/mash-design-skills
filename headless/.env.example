# Local stack. mds setup writes the real values into the stack penpot.env.
PENPOT_BASE_URL=http://localhost:9001
PENPOT_ACCESS_TOKEN=

# Optional on-disk JSON token file. The Penpot file library is the catalog
# the skills read and write.
PENPOT_TOKENS_PATH=

# Required for penpot_export_shape. Same account as the access token.
PENPOT_LOGIN_EMAIL=
PENPOT_LOGIN_PASSWORD=

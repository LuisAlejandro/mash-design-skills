{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "od-design-candidates/candidates.schema.json",
  "title": "DesignCandidatesMetadata",
  "type": "object",
  "required": [
    "generatedAt",
    "pageSlug",
    "brief",
    "designSystem",
    "variationPlanner",
    "variations"
  ],
  "additionalProperties": true,
  "properties": {
    "generatedAt": { "type": "string" },
    "repoRoot": { "type": "string" },
    "pageSlug": { "type": "string", "minLength": 1 },
    "brief": { "type": "string" },
    "winnerVariation": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 3
    },
    "designSystem": {
      "type": "object",
      "required": ["designSystemId", "designPath", "checksum"],
      "properties": {
        "designSystemId": { "type": "string", "minLength": 1 },
        "designPath": { "type": "string" },
        "checksum": { "type": "string" },
        "manifest": { "type": "object" }
      }
    },
    "variationPlanner": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "surface": { "type": "string" },
        "plannerAgent": { "type": ["string", "null"] },
        "plannerModel": { "type": ["string", "null"] }
      }
    },
    "variations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["variation", "html", "title"],
        "properties": {
          "variation": { "type": "integer", "minimum": 1, "maximum": 3 },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "directive": { "type": "string" },
          "html": { "type": "string" },
          "png": { "type": ["string", "null"] },
          "projectId": { "type": ["string", "null"] },
          "runId": { "type": ["string", "null"] },
          "projectMetadataPath": { "type": ["string", "null"] }
        }
      }
    }
  }
}

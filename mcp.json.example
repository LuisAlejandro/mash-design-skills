{
  "mcpServers": {
    "penpot-local": {
      "command": "node",
      "args": ["~/.config/mash/headless/dist/server.js"],
      "env": {
        "PENPOT_BASE_URL": "http://localhost:9001",
        "PENPOT_ACCESS_TOKEN": "",
        "PENPOT_LOGIN_EMAIL": "",
        "PENPOT_LOGIN_PASSWORD": ""
      }
    }
  }
}

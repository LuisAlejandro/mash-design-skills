{
  "name": "penpot-local",
  "version": "0.1.1",
  "private": true,
  "description": "Penpot stdio MCP server for Mash Design Skills. Edits a local Penpot file over RPC.",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "license": "MIT",
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "opentype.js": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
